# mbc.mw/go/<name>  ->  index.php?s=<name>
# This folder's rules replace WordPress's for everything under /go/.
DirectoryIndex index.php
Options -Indexes

RewriteEngine On
RewriteBase /go/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-]+)/?$ index.php?s=$1 [L,QSA]
